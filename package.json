    "seed": "node scripts/seed.js",
    "queries": "node scripts/queries.js"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8"
  }
}
