{
  "name": "bus-booking-system",
  "version": "1.0.0",
  "description": "Express + Sequelize (MySQL) API for a bus booking system",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "db:init": "mysql -u root -p < schema.sql",
    "demo": "node scripts/kohli-demo.js",
